# Path to the SQLite file. On Render, point this at a mounted disk (e.g. /var/data/patients.db)
DATABASE_PATH=patients.db

# Shared secret you also set as a custom header on every Vapi tool (X-Vapi-Secret).
# Leave blank to disable webhook auth (local dev only).
VAPI_SERVER_SECRET=

# Seed 2 demo patients on first startup
SEED_DATA=true
